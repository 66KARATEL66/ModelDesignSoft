Table AnimeSeries { Id int [pk] Title varchar Studio varchar } Table Figurine { Id int [pk] Name varchar Price int AnimeSeriesId int [ref: > AnimeSeries.Id] } Table FigurineSpecification { Id int [pk] FigurineId int [unique, ref: - Figurine.Id] HeightCm decimal Material varchar LimitedEdition boolean } Table CollectionTag { Id int [pk] Name varchar } Table FigurineTag { FigurineId int [pk, ref: > Figurine.Id] TagId int [pk, ref: > CollectionTag.Id] } Table Customer { Id int [pk] Name varchar Phone varchar Email varchar } Table "Order" { Id int [pk] CustomerId int [ref: > Customer.Id] CreatedAt datetime Status varchar } Table OrderItem { Id int [pk] OrderId int [ref: > "Order".Id] FigurineId int [ref: > Figurine.Id] Quantity int UnitPrice decimal } Table Payment { Id int [pk] OrderId int [ref: - "Order".Id] Amount decimal Status varchar }
